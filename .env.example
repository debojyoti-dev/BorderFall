# ---------------------------------------------------------------------------
# BorderFall — environment configuration
# Copy to `.env` and adjust. Never commit a populated `.env`.
# ---------------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# --- Server ----------------------------------------------------------------
HOST=0.0.0.0
PORT=3001

# Comma-separated allow-list of browser origins permitted to connect.
# A wildcard is rejected in production: Socket.IO connections carry credentials.
CORS_ORIGINS=http://localhost:5173

# --- Authentication --------------------------------------------------------
# REQUIRED in production. The server refuses to start without it.
# Generate with: openssl rand -base64 48
JWT_SECRET=dev-insecure-secret
JWT_EXPIRES_IN=7d

# --- Persistence -----------------------------------------------------------
# Persistence is optional: with MONGO_ENABLED=false the game runs entirely in
# memory, which is the fastest way to develop gameplay. Matches, replays and
# statistics are simply not saved.
MONGO_ENABLED=false
MONGO_URI=mongodb://localhost:27017/borderfall

# Redis is only needed to run more than one server process (Socket.IO adapter
# and cross-node matchmaking). Single-node deployments do not need it.
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# --- Observability ---------------------------------------------------------
# debug | info | warn | error | silent
LOG_LEVEL=debug
# Structured JSON logs; enable in production for log shipping.
LOG_JSON=false
METRICS_ENABLED=true

# --- Capacity --------------------------------------------------------------
MAX_CONCURRENT_MATCHES=8

# --- Client (Vite; only VITE_-prefixed vars reach the browser) --------------
# Leave empty to use the Vite dev proxy on the same origin.
VITE_SERVER_URL=
