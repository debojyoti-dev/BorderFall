{
  "name": "@borderfall/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Authoritative BorderFall simulation server.",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -b",
    "test": "vitest run --dir src"
  },
  "dependencies": {
    "@borderfall/shared": "*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
